{
  "name": "@kunlunxu/wf-extension-markdown",
  "version": "3.0.6",
  "repository": "github:KunLunXu-CC/writeflow",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kunlunxu/wf-core": "workspace:^",
    "@mdit/plugin-tasklist": "^0.22.3",
    "markdown-it": "^14.1.0",
    "prosemirror-markdown": "^1.13.2",
    "prosemirror-model": "^1.25.3"
  }
}
